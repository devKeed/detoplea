# EmailJS Configuration
# Get these values from your EmailJS dashboard
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_your_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_your_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Mailchimp Configuration
# Get these values from your Mailchimp account
MAILCHIMP_API_KEY=your_mailchimp_api_key
MAILCHIMP_SERVER_PREFIX=us8
MAILCHIMP_LIST_ID=your_list_id

# WordPress REST API Configuration
# Set this to your WordPress site's REST API base URL
# Example: https://your-wordpress-site.com/wp-json/wp/v2
NEXT_PUBLIC_WP_API_BASE=https://example.com/wp-json/wp/v2
